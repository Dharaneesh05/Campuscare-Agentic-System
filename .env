# CampusCare AI Environment Variables
# Hugging Face Access Token (get one free at https://huggingface.co/settings/tokens)
HF_TOKEN=your_huggingface_token_here

# Hugging Face Model Name (free serverless inference API)
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# n8n Webhook URL (configured in Step 12)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/campuscare-complaint

# Application Host & Port
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=7860
