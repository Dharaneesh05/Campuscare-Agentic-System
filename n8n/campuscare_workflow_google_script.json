{
  "name": "CampusCare AI Automated Resolution Workflow (Google Mail Webhook)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "campuscare-complaint",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-1",
      "name": "Webhook Receiver",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "campuscare-complaint"
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.body.priority }}",
        "rules": {
          "rules": [
            {
              "value2": "URGENT"
            },
            {
              "value2": "HIGH"
            },
            {
              "value2": "MEDIUM"
            }
          ]
        },
        "fallbackOutput": 3
      },
      "id": "node-priority-switch",
      "name": "Priority Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "escalation_status",
              "value": "CRITICAL_ESCALATION_TRIGGERED"
            },
            {
              "name": "sms_alert",
              "value": "SMS alert dispatched to department lead."
            }
          ]
        },
        "options": {}
      },
      "id": "node-urgent-escalation",
      "name": "Urgent Emergency Dispatch",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [720, 160]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "string": [
            {
              "name": "escalation_status",
              "value": "STANDARD_ROUTING"
            }
          ]
        },
        "options": {}
      },
      "id": "node-standard-routing",
      "name": "Standard Priority Dispatch",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [720, 360]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PASTE_YOUR_GOOGLE_APPS_SCRIPT_URL_HERE",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Webhook Receiver').item.json.body.department_notification.to || 'dharaneeshc2006@gmail.com', subject: '[DEPARTMENT ALERT] ' + $('Webhook Receiver').item.json.body.priority + ' Priority - Ticket #' + $('Webhook Receiver').item.json.body.ticket_id + ': ' + $('Webhook Receiver').item.json.body.category, html: '<div style=\"font-family:Arial,sans-serif;padding:24px;border:1px solid #e2e8f0;border-radius:8px;max-width:600px;margin:auto;\"><h2 style=\"color:#dc2626;border-bottom:2px solid #ef4444;padding-bottom:8px;\">🚨 CampusCare AI - Department Action Required</h2><table style=\"width:100%;border-collapse:collapse;margin-top:16px;\"><tr style=\"background:#f8fafc;\"><td style=\"padding:8px;font-weight:bold;width:35%;\">Ticket ID:</td><td style=\"padding:8px;color:#2563eb;font-weight:bold;\">#' + $('Webhook Receiver').item.json.body.ticket_id + '</td></tr><tr><td style=\"padding:8px;font-weight:bold;\">Department:</td><td style=\"padding:8px;\">' + $('Webhook Receiver').item.json.body.department + '</td></tr><tr style=\"background:#f8fafc;\"><td style=\"padding:8px;font-weight:bold;\">Priority:</td><td style=\"padding:8px;\"><span style=\"background:#fee2e2;color:#991b1b;padding:3px 8px;border-radius:6px;font-weight:bold;\">' + $('Webhook Receiver').item.json.body.priority + '</span></td></tr><tr><td style=\"padding:8px;font-weight:bold;\">Location:</td><td style=\"padding:8px;\">' + $('Webhook Receiver').item.json.body.location + '</td></tr><tr style=\"background:#f8fafc;\"><td style=\"padding:8px;font-weight:bold;\">Student:</td><td style=\"padding:8px;\">' + $('Webhook Receiver').item.json.body.student_name + ' (' + $('Webhook Receiver').item.json.body.student_email + ') - ' + $('Webhook Receiver').item.json.body.class_department + '</td></tr></table><div style=\"background:#f1f5f9;padding:12px;border-radius:6px;margin-top:16px;\"><strong>Issue Summary:</strong><p style=\"margin:6px 0 0 0;\">' + $('Webhook Receiver').item.json.body.summary + '</p></div><div style=\"background:#fef2f2;padding:12px;border-radius:6px;margin-top:12px;\"><strong>Detailed Complaint:</strong><p style=\"margin:6px 0 0 0;\">' + $('Webhook Receiver').item.json.body.complaint + '</p></div><div style=\"background:#ecfdf5;padding:12px;border-radius:6px;margin-top:12px;\"><strong>Suggested Action:</strong><p style=\"margin:6px 0 0 0;\">' + $('Webhook Receiver').item.json.body.suggested_action + '</p></div></div>' }) }}",
        "options": {}
      },
      "id": "node-notify-dept-gas",
      "name": "Send Email to Department (Gmail Web App)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 240]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "PASTE_YOUR_GOOGLE_APPS_SCRIPT_URL_HERE",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('Webhook Receiver').item.json.body.student_email, subject: '[STUDENT CONFIRMATION] Ticket #' + $('Webhook Receiver').item.json.body.ticket_id + ' Registered - ' + $('Webhook Receiver').item.json.body.category, html: '<div style=\"font-family:Arial,sans-serif;padding:24px;border:1px solid #e2e8f0;border-radius:8px;max-width:600px;margin:auto;\"><h2 style=\"color:#059669;border-bottom:2px solid #10b981;padding-bottom:8px;\">🎓 CampusCare AI - Complaint Acknowledged</h2><p>Dear <strong>' + $('Webhook Receiver').item.json.body.student_name + '</strong>,</p><p>Thank you for submitting your complaint regarding <strong>' + $('Webhook Receiver').item.json.body.category + '</strong> at <strong>' + $('Webhook Receiver').item.json.body.location + '</strong>.</p><div style=\"background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:16px;margin:16px 0;\"><p style=\"margin:0 0 8px 0;\"><strong>Ticket ID:</strong> <span style=\"color:#2563eb;font-weight:bold;\">#' + $('Webhook Receiver').item.json.body.ticket_id + '</span></p><p style=\"margin:0 0 8px 0;\"><strong>Assigned Department:</strong> ' + $('Webhook Receiver').item.json.body.department + '</p><p style=\"margin:0 0 8px 0;\"><strong>Priority:</strong> ' + $('Webhook Receiver').item.json.body.priority + '</p><p style=\"margin:0;\"><strong>Official Response:</strong> ' + $('Webhook Receiver').item.json.body.response + '</p></div><p style=\"color:#64748b;font-size:13px;\">The department team has been alerted. You will receive updates as resolution proceeds.</p></div>' }) }}",
        "options": {}
      },
      "id": "node-ack-student-gas",
      "name": "Send Confirmation Email to Student (Gmail Web App)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 420]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"status\": \"success\",\n  \"ticket_id\": \"{{ $('Webhook Receiver').item.json.body.ticket_id }}\",\n  \"assigned_department\": \"{{ $('Webhook Receiver').item.json.body.department }}\",\n  \"priority\": \"{{ $('Webhook Receiver').item.json.body.priority }}\",\n  \"acknowledged\": true,\n  \"message\": \"n8n automation successfully dispatched real emails via Gmail Webhook to department and student.\"\n}",
        "options": {}
      },
      "id": "node-webhook-response",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1200, 320]
    }
